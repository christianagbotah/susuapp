{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iSusuPro",
  "version": "1.0.0",
  "identifier": "com.isusupro.ghana.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "iSusuPro — Ghana Susu & Microfinance",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://*.isusupro.com https://api.hubtel.com https://api.paystack.co; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "iSusuPro — Ghana Susu Banking"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 iSusuPro Ghana",
    "category": "Finance",
    "shortDescription": "Ghana's susu & microfinance suite",
    "longDescription": "iSusuPro is the complete susu and microfinance platform for Ghana — daily susu collections, MTN MoMo / Telecel Cash / AT Money floats, 5C loan appraisals, Bank of Ghana NBFRI compliance, AML monitoring and offline-first agent collections. Built for branches in Accra, Kumasi and beyond.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "exceptionDomain": ""
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "dialog": true
    }
  }
}
