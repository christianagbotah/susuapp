# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# Dev process id files
.zscripts/*.pid
.data/

# Agent tool output (screenshots, vision analysis JSON) — never commit
tool-results/

# ===== Native builds =====
# Bootstrap shell (generated by scripts/build-native-shell.mjs)
/dist/
# Icon source (intermediate for `tauri icon`)
/app-icon-1024.png

# Android (Capacitor) — build outputs & local config only; project files ARE committed
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/*.iml
android/capacitor-cordova-android-plugins/build/
android/app/src/main/assets/capacitor-cordova-android-plugins/*/build/

# Tauri — Rust build artifacts (src-tauri/target & gen have their own .gitignore too)
src-tauri/target/
src-tauri/gen/
